# WriteGen AI - Environment Configuration Template

# Google Gemini API Key - Get yours from Google AI Studio (https://aistudio.google.com)
# If left blank, the application will start in mock demo mode for testing.
GEMINI_API_KEY=

# MongoDB Configuration
# For local dev: mongodb://localhost:27017
# For Docker Compose: mongodb://mongodb:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=writegen_ai

# Server Port
PORT=8000
